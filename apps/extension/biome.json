{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noEmptyPattern": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "warn",
        "useExponentiationOperator": "warn"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noForEach": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/*.snap",
      "!**/__snapshots__",
      "!**/vite.config.ts",
      "!**/vitest.config.ts",
      "!**/tsconfig.json"
    ]
  }
}
