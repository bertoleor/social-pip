{
  "manifest_version": 3,
  "name": "Social-Pip Extension",
  "version": "1.0.0",
  "description": "Automatización de redes sociales - Browser automation para posting",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.twitter.com/*",
    "*://*.tiktok.com/*",
    "*://*.linkedin.com/*",
    "*://*.threads.net/*",
    "*://*.telegram.org/*",
    "*://*.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["src/content/facebook/index.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["src/content/instagram/index.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.twitter.com/*", "*://*.x.com/*"],
      "js": ["src/content/twitter/index.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}