{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useButtonType": "warn",
        "useSemanticElements": "warn",
        "useKeyWithClickEvents": "warn",
        "useFocusableInteractive": "warn",
        "noLabelWithoutControl": "warn",
        "useValidAnchor": "warn"
      },
      "correctness": {
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "warn",
        "noEmptyPattern": "warn"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "warn",
        "useExponentiationOperator": "warn"
      },
      "complexity": {
        "useLiteralKeys": "off",
        "noForEach": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noExplicitAny": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      "coverage",
      "src-tauri/target",
      "src-tauri/gen",
      "*.snap",
      "__snapshots__",
      "playwright.config.ts",
      "vite.config.ts",
      "vitest.config.ts",
      "tsconfig.json"
    ]
  }
}
