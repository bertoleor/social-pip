# ============================================
# SOCIAL-PIP - Environment Variables Template
# ============================================
# COPIAR ESTE ARCHIVO A .env Y COMPLETAR LOS VALORES
# NO COMMITEAR ESTE ARCHIVO A GIT

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# DATABASE - SQLite for Tauri
# ============================================
# Para desarrollo local (Tauri usa SQLite)
DATABASE_URL=file:./social-pip.db

# ============================================
# JWT & AUTH
# ============================================
JWT_SECRET=your-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# ============================================
# TAURI CONFIGURATION
# ============================================
TAURI_APP_NAME=Social-Pip
TAURI_WINDOW_TITLE=Social-Pip - Automatización de Redes Sociales
TAURI_WINDOW_WIDTH=1200
TAURI_WINDOW_HEIGHT=800

# ============================================
# NVIDIA AI (Optional - for content generation)
# ============================================
# NVIDIA_API_KEY=your-nvidia-api-key

# ============================================
# CHROME EXTENSION
# ============================================
# Extension ID se genera automáticamente al cargar
# EXTENSION_ID=your-extension-id

# ============================================
# DEVELOPMENT PORTS
# ============================================
VITE_DEV_PORT=1420