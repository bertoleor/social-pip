# ============================================
# SOCIAL-PIP - Environment Variables Template
# ============================================
# COPIAR ESTE ARCHIVO A .env Y COMPLETAR LOS VALORES
# NO COMMITEAR EL .env A GIT
#
# Regla F0 (2026-09-27): SOLO NOMBRES y placeholders — sin valores reales.
# Las variables comentadas aún no se leen en el código (verificadas con
# `git grep` el 2026-09-27; solo DATABASE_URL se usa, en
# packages/database/prisma/schema.prisma). Se dejan porque documentan la
# intención de configuración del runtime Tauri/Vite.

# ============================================
# NODE ENVIRONMENT
# ============================================
# Usada por Vite/Node para distinguish dev vs production.
NODE_ENV=

# ============================================
# DATABASE - SQLite via Prisma
# ============================================
# ÚNICA variable con uso real hoy (packages/database/prisma/schema.prisma).
# Formato esperado: file:<ruta-a-tu-db-local>
DATABASE_URL=

# ============================================
# JWT & AUTH (reservadas — sin uso en código hoy)
# ============================================
JWT_SECRET=
JWT_EXPIRES_IN=

# ============================================
# TAURI CONFIGURATION (reservadas — sin uso en código hoy)
# ============================================
TAURI_APP_NAME=
TAURI_WINDOW_TITLE=
TAURI_WINDOW_WIDTH=
TAURI_WINDOW_HEIGHT=

# ============================================
# VITE DEV SERVER (reservada — sin uso en vite.config.ts hoy)
# ============================================
VITE_DEV_PORT=

# ============================================
# NVIDIA AI (opcional — sin uso en código hoy)
# ============================================
# NVIDIA_API_KEY=
