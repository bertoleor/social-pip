{
  "name": "social-pip",
  "version": "1.0.0",
  "private": true,
  "description": "Social-Pip - Automatización de redes sociales 100% gratuita para Argentina/LATAM",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "cd apps/desktop && npm run dev",
    "dev:extension": "cd apps/extension && npm run dev",
    "start": "pnpm --filter @social-pip/desktop dev",
    "start:tauri": "pnpm --filter @social-pip/desktop tauri dev",
    "setup": "pnpm install && pnpm db:generate && pnpm db:migrate",
    "build": "turbo run build",
    "build:desktop": "cd apps/desktop && npm run tauri build",
    "build:extension": "cd apps/extension && npm run build",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=json --reporter=default",
    "test:e2e": "cd apps/desktop && pnpm test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "cd packages/database && npm run prisma:generate",
    "db:migrate": "cd packages/database && npm run prisma:migrate",
    "db:studio": "cd packages/database && npm run prisma:studio",
    "knip": "knip",
    "biome:scan": "npx -y @biomejs/biome lint apps/*/src packages/*/src",
    "copy-paste:check": "jscpd apps packages",
    "spell:check": "cspell README.md docs"
  },
  "devDependencies": {
    "@cspell/dict-es-es": "^3.0.9",
    "cspell": "^10.4.0",
    "jscpd": "^5.4.1",
    "knip": "^6.42.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "author": "Social-Pip Team",
  "license": "MIT"
}
