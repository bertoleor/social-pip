{
  "name": "social-pip",
  "version": "1.0.0",
  "private": true,
  "description": "Social-Pip - Automatización de redes sociales 100% gratuita para Argentina/LATAM",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:desktop": "pnpm --filter @social-pip/desktop dev",
    "dev:extension": "pnpm --filter @social-pip/extension dev",
    "start": "pnpm --filter @social-pip/desktop dev",
    "start:tauri": "pnpm --filter @social-pip/desktop tauri dev",
    "setup": "pnpm install && pnpm db:generate && pnpm db:migrate",
    "build": "turbo run build",
    "build:desktop": "pnpm --filter @social-pip/desktop tauri build",
    "build:extension": "pnpm --filter @social-pip/extension build",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=json --reporter=default",
    "test:e2e": "cd apps/desktop && pnpm test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @social-pip/database prisma:generate",
    "db:migrate": "pnpm --filter @social-pip/database prisma:migrate",
    "db:studio": "pnpm --filter @social-pip/database prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.11.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "author": "Social-Pip Team",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "source-map-js@<1.2.2": ">=1.2.2"
    }
  }
}