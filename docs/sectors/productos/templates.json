{
  "sector": "productos",
  "templates": [
    {
      "name": "Producto Genérico",
      "structure": [
        {
          "type": "hook",
          "description": "Problema que resuelve",
          "example": "El accesorio que te falta en tu cocina.",
          "rules": "Pain puntual. Sin 'revolucionario'."
        },
        {
          "type": "product",
          "description": "Qué es y características",
          "example": "Organizador extensible para cajones: ajusta de 30 cm a 55 cm. Material: bamboo premium. Resistente al agua.",
          "rules": "Medidas, material, resistencia — datos técnicos primero."
        },
        {
          "type": "use",
          "description": "Para qué sirve",
          "example": "Mantené tu cocina ordenada: cubiertos, utensilios, servilletas.",
          "rules": "Casos de uso concretos."
        },
        {
          "type": "price",
          "description": "Precio visible",
          "example": "💲 $4.200 ARS (envío gratis a partir de $10.000)",
          "rules": "Moneda + condiciones de envío."
        },
        {
          "type": "cta",
          "description": "Acción",
          "example": "🛒 Comprar ahora: [link]",
          "rules": "Link directo o WhatsApp."
        },
        {
          "type": "hashtags",
          "description": "Hashtags sector",
          "example": "#cocina #organizador #bamboo #hogar #producto",
          "rules": "Máximo 5."
        }
      ],
      "characterLimit": 400,
      "emojiMax": 2
    },
    {
      "name": "Regalo",
      "structure": [
        {
          "type": "hook",
          "description": "Ángulo regalo",
