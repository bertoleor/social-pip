          "rules": "Contenido exacto + compatibilidad."
        },
        {
          "type": "use",
          "description": "Uso",
          "example": "Para el que le gusta arreglar sus cosas o simplemente tener el kit listo.",
          "rules": "Sin exagerar."
        },
        {
          "type": "logistics",
          "description": "Logística",
          "example": "📦 Envíos a todo el país.",
          "rules": "Zona y plazo."
        },
        {
          "type": "price",
