          "rules": "Moneda + precio."
        },
        {
          "type": "cta",
          "description": "Acción",
          "example": "Comprar: [link]",
          "rules": "Link directo."
        },
        {
          "type": "hashtags",
          "description": "Hashtags sector",
          "example": "#regalo #tecnologia #herramientas #gift #producto",
          "rules": "Máximo 5."
