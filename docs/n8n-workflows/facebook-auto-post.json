{
  "name": "SP - Facebook Auto Post",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,12,15,18 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Social-Pip Facebook Pre-Publish Check\nconst item = $input.first().json;\n\n// Anti-ban: Check daily limits\nconst FACEBOOK_MAX_DAILY = 10;\nconst FACEBOOK_MIN_DELAY_MS = 30 * 60 * 1000; // 30 minutes\n\n// Get account stats from DB (simulated)\nconst accountStats = {\n  postsToday: item.postsToday || 0,\n  lastPostAt: item.lastPostAt ? new Date(item.lastPostAt) : null,\n  accountStatus: item.accountStatus || 'ACTIVE'\n};\n\n// Validation checks\nconst errors = [];\n\n// Check daily limit\nif (accountStats.postsToday >= FACEBOOK_MAX_DAILY) {\n  errors.push(`Daily limit reached: ${accountStats.postsToday}/${FACEBOOK_MAX_DAILY}`);\n}\n\n// Check delay since last post\nif (accountStats.lastPostAt) {\n  const timeSinceLastPost = Date.now() - accountStats.lastPostAt.getTime();\n  if (timeSinceLastPost < FACEBOOK_MIN_DELAY_MS) {\n    const waitMinutes = Math.ceil((FACEBOOK_MIN_DELAY_MS - timeSinceLastPost) / 60000);\n    errors.push(`Too soon since last post. Wait ${waitMinutes} more minutes.`);\n  }\n}\n\n// Check account status\nif (accountStats.accountStatus === 'BANNED' || accountStats.accountStatus === 'RESTRICTED') {\n  errors.push(`Account status: ${accountStats.accountStatus}. Cannot post.`);\n}\n\nif (errors.length > 0) {\n  return {\n    json: {\n      valid: false,\n      errors: errors,\n      accountStats: accountStats\n    }\n  };\n}\n\nreturn {\n  json: {\n    valid: true,\n    post: item,\n    accountStats: accountStats\n  }\n};"
      },
      "id": "validate-anti-ban",
      "name": "Validate Anti-Ban",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "valid-check",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-valid",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/facebook/post",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "HTTP Header Auth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{ $env.SOCIAL_PIP_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"accountId\": \"{{ $json.post.accountId }}\",\n  \"content\": \"{{ $json.post.content }}\",\n  \"mediaUrls\": {{ JSON.stringify($json.post.mediaUrls || []) }},\n  \"platform\": \"facebook\"\n}"
      },
      "id": "publish-facebook",
      "name": "Publish to Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [850, 200],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Parse Facebook publish result\nconst result = $input.first().json;\n\nif (result.error) {\n  return {\n    json: {\n      success: false,\n      error: result.error,\n      errorCode: result.errorCode || 'UNKNOWN',\n      platform: 'facebook'\n    }\n  };\n}\n\nreturn {\n  json: {\n    success: true,\n    postId: result.id,\n    postUrl: result.url,\n    publishedAt: new Date().toISOString(),\n    platform: 'facebook'\n  }\n};"
      },
      "id": "parse-result",
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/logs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"platform\": \"facebook\",\n  \"action\": \"POST_FEED\",\n  \"status\": {{ $json.success ? '\"success\"' : '\"failed\"' }},\n  \"postUrl\": \"{{ $json.postUrl || '' }}\",\n  \"errorMessage\": \"{{ $json.error || '' }}\",\n  \"errorCode\": \"{{ $json.errorCode || '' }}\",\n  \"accountId\": \"{{ $json.accountId || '' }}\"\n}"
      },
      "id": "log-result",
      "name": "Log Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🚫 Facebook Post Blocked\n\nReason: {{ $json.errors.join(', ') }}\n\nAccount: {{ $json.accountStats.accountStatus }}"
      },
      "id": "notify-blocked",
      "name": "Notify Blocked",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [850, 400]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=✅ Facebook Post Published\n\nPost ID: {{ $json.postId }}\nURL: {{ $json.postUrl }}"
      },
      "id": "notify-success",
      "name": "Notify Success",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1250, 50]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Validate Anti-Ban",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Anti-Ban": {
      "main": [
        [
          {
            "node": "Is Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Valid?": {
      "main": [
        [
          {
            "node": "Publish to Facebook",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify Blocked",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish to Facebook": {
      "main": [
        [
          {
            "node": "Parse Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Result": {
      "main": [
        [
          {
            "node": "Log Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Result": {
      "main": [
        [
          {
            "node": "Notify Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorPolicy": "default"
  },
  "staticData": null,
  "tags": [
    {
      "name": "social-pip",
      "createdAt": "2026-04-10T00:00:00.000Z",
      "updatedAt": "2026-04-10T00:00:00.000Z"
    },
